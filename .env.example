# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ==============================================================================
# Copia este archivo y renómbralo como ".env.local" para colocar tus claves reales.
# IMPORTANTE: Nunca subas el archivo ".env.local" a GitHub.

# ------------------------------------------------------------------------------
# 1. Configuración de Supabase (Base de datos PostgreSQL)
# ------------------------------------------------------------------------------
# URL del proyecto en Supabase (ej: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=tu_supabase_project_url

# Clave pública anónima de Supabase (segura para usarse en el frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_supabase_anon_key

# Clave secreta con rol de servicio (SOLO para el backend, nunca compartirla)
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key

# ------------------------------------------------------------------------------
# 2. Configuración de OpenAI (Inteligencia Artificial)
# ------------------------------------------------------------------------------
# Clave de API de OpenAI para interpretar mensajes y procesar audios
OPENAI_API_KEY=tu_openai_api_key

# ------------------------------------------------------------------------------
# 3. Configuración de WhatsApp Cloud API (Meta)
# ------------------------------------------------------------------------------
# Token de acceso que te da Meta Developers para enviar mensajes
WHATSAPP_TOKEN=tu_whatsapp_access_token

# Token secreto inventado por ti para verificar que Meta se conecte a tu Webhook
WHATSAPP_VERIFY_TOKEN=tu_token_secreto_de_verificacion

# ID del número de teléfono que te asigna Meta en la consola de WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id
